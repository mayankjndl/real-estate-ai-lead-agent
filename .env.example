# Gemini AI
GEMINI_API_KEY=

# Internal auth key for admin endpoints
API_AUTH_KEY=

# PostgreSQL connection string
DATABASE_URL=postgresql://realestate:localpass@localhost:5432/realestate_db

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# Security & Encryption Keys
JWT_SECRET_KEY=
ADMIN_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Per-client API keys (provisioned by seed.py)
CLIENT_KEY_A=
CLIENT_KEY_B=

# ngrok — get your auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Set to true on Render/production
IS_PRODUCTION=false

# Set to true for test mode
FOLLOW_UP_TEST_MODE=false

# Set to true for test mode for DLQ
FOLLOW_UP_DLQ_TEST=false

# Set to true for twilio bypass for automation script
TEST_MODE=false

# --- Notification & Escalation Variables ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Sender Account Credentials (Email A)
SMTP_USER=
SMTP_PASS=

# Default Fallback Recipient (Email B - No 2FA required to receive)
ADMIN_EMAIL=

# Twilio Status Callback Tracking
# (Use your ngrok URL for local testing, e.g., https://1234-abcd-efgh.ngrok-free.dev)
WEBHOOK_BASE_URL=

# --- IREIOS 3.0 expansion (consumed starting in later phases; safe legacy defaults) ---
# Redis Streams event bus (Phase 1)
EVENT_STREAM_KEY=ireios:events
EVENT_CONSUMER_GROUP=ireios-cg

# WhatsApp Agent v3 feature flag (Phase 5) — true is the production default (v3
# WhatsAppAgent). Set false to roll back to the legacy process_chat path.
FEATURE_WHATSAPP_V3=true

# WhatsApp latency / Twilio race window (seconds). Must stay under Twilio ~15s HTTP.
# On exceed: interim "Just checking..." + await same in-flight turn (no re-run).
WHATSAPP_WEBHOOK_TIMEOUT=13.0
# Gemini hard cap — may exceed race window (in-flight continues after interim).
LLM_TIMEOUT_SECONDS=22.0
# Pre-LLM context budgets (keep tight vs race window).
RAG_TIMEOUT_SECONDS=2.0
GRAPH_CONTEXT_TIMEOUT_SECONDS=0.5
# Shown in WA fatal fallbacks / escalate lines
CLIENT_SUPPORT_NUMBER=+91 9876543210

# Follow-up engine selector (Phase 4): legacy | v3 | shadow (v3 = production)
FOLLOWUP_ENGINE=v3

# Neo4j knowledge graph (Phase 7)
# Required for graph labels (:Lead/:Agent/:Property/:SchemaVersion) and lead
# projections. Leave NEO4J_URI empty for graceful no-op (chat still works).
#
# Local setup (teammates):
#   1. docker compose up -d neo4j redis
#   2. Copy these three vars into your .env (password must match docker NEO4J_AUTH)
#   3. pip install -r requirements.lock   # includes neo4j==5.28.2
#   4. Start API AFTER Neo4j is up (restart API if Neo4j was down at first boot)
#   5. GET http://localhost:8000/api/v1/graph/health  → available:true, schema_version:1
#   6. Browser http://localhost:7474  → Nodes(1) SchemaVersion + label chips
#
# Host API + docker Neo4j: bolt://localhost:7687
# API inside compose network: bolt://neo4j:7687
# docker-compose NEO4J_AUTH defaults to neo4j/localpass
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localpass

# n8n automation (optional ops plane) — leave empty for n8n_not_configured (safe no-op)
# Local Docker: docker compose up -d n8n → http://localhost:5678 (owner setup on first visit)
# TWO KEYS (do not mix):
#   N8N_API_KEY = webhook Header Auth secret. Backend sends Authorization: Bearer {this}.
#     In n8n UI credential "IREIOS API Key": header name Authorization, value "Bearer <same secret>".
#   N8N_MANAGEMENT_API_KEY = JWT from n8n UI Settings → n8n API. Only for import_n8n_workflows.py
#     (POST /api/v1/workflows). The webhook secret will always 401 the management API.
# See docs/N8N_INTEGRATION.md
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=local-n8n-webhook-secret
N8N_MANAGEMENT_API_KEY=

# Bus→n8n bridge (default on). Separate Redis group ireios-n8n; POSTs full envelopes to webhooks.
# Stock n8n cannot read Redis Streams — do not point n8n Redis Trigger at ireios:events.
N8N_BRIDGE_ENABLED=true
N8N_BRIDGE_GROUP=ireios-n8n

# Optional JSON map event_type → webhook path (empty = defaults in n8n_bridge.DEFAULT_WEBHOOK_MAP)
# N8N_WEBHOOK_MAP={"lead.hot":"ireios_hot_lead_alert","lead.qualified":"ireios_crm_note"}

# Optional: pin credential encryption across n8n container recreate (docker-compose default if unset)
# N8N_ENCRYPTION_KEY=ireios-local-n8n-encryption-key

# Competitor monitor watch-list (Phase 8) — comma-separated keywords, no network
COMPETITOR_KEYWORDS=

# Google Calendar (real CalendarExecutor) — leave empty to use synthetic visit_id stub.
# Put real values only in local .env (never commit SA JSON paths or personal calendar IDs).
# GOOGLE_CALENDAR_CREDENTIALS_JSON = absolute path to service-account JSON.
# Windows: use forward slashes (D:/path/to/key.json). Backslash+\r in \real_... is eaten as CR.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# WhatsApp brochure / floor plan media (Approach B) — public HTTPS URLs Twilio can GET.
# Empty = plain-text generate_brochure / generate_floorplan fallback (INCOMPLETE until set).
# Non-https:// values are rejected by resolve_tool_media_url.
# Example: host PDF on S3/Cloudinary/ngrok-static; Twilio must be able to GET the URL.
BROCHURE_MEDIA_URL=https://cdn.jsdelivr.net/gh/mayankjndl/real-estate-ai-lead-agent@phase3_expansion/docs/demo/brochure.pdf
FLOORPLAN_MEDIA_URL=https://cdn.jsdelivr.net/gh/mayankjndl/real-estate-ai-lead-agent@phase3_expansion/docs/demo/floorplan.pdf

# HubSpot CRM (optional) — read by crm_sync via os.getenv (not Settings).
# CRM_API_KEY = HubSpot Private App Token (Authorization: Bearer <token>).
# Scopes sufficient: crm.objects.contacts read/write (companies unused; no custom objects).
# Identity match: email + phone. Bi-di deferred IREIOS 4.1.
# CRM_API_URL=https://api.hubapi.com/crm/v3/objects/contacts
# CRM_API_KEY=

# CRM_SYNC_EXTENDED_PROPERTIES=true

# IREIOS 4.0 feature flags
FEATURE_GRAPH_VIZ=true
FEATURE_TWIN_LIVE=true

# Keep false until real CRM_API_KEY + portal ready (Piyush). When false, crm_sync stubs.
FEATURE_HUBSPOT_LIVE=false

# --- PRODUCTION GO-LIVE CHECKLIST (flip before deploy) ---
# IS_PRODUCTION=true, TEST_MODE=false, FOLLOW_UP_TEST_MODE=false,
# FOLLOW_UP_DLQ_TEST=false, real TWILIO_* creds, real NEO4J_* (optional),
# real N8N_* (optional), GOOGLE_CALENDAR_* (optional), BROCHURE_* / FLOORPLAN_*
# (optional HTTPS media), real CRM_API_* (optional; HubSpot skippable),
# FEATURE_HUBSPOT_LIVE=true only with real key. See AGENTS.md.
